NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5500
API_BASE_PATH=/api

DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=
DB_CONNECTION_LIMIT=10

GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback
SESSION_JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY_HEX=replace-with-64-hexadecimal-characters

ORGANIZATION_NAME=SEO Analytics Organization
# Required for the organization migration when existing users are present.
INITIAL_ORG_ADMIN_EMAIL=

# SMTP is required for employee invitation delivery.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-account@gmail.com
SMTP_PASSWORD=your-app-password
INVITATION_FROM_EMAIL=your-account@gmail.com

SYNC_WORKER_ENABLED=true
SYNC_POLL_INTERVAL_MS=5000
SYNC_FRESHNESS_HOURS=24
GA4_LOOKBACK_DAYS=7
GSC_LOOKBACK_DAYS=3
HISTORICAL_MONTHS=16
SYNC_CHUNK_DAYS=30
MAX_SYNC_ATTEMPTS=3
